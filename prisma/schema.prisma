generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum UserStatus { ACTIVE SUSPENDED DISABLED }
enum ObjectStatus { STOLEN FOUND UNDER_VERIFICATION WAITING_RETURN RETURNED CLOSED CANCELLED }
enum IdentifierType { IMEI IMEI2 SERIAL_NUMBER VIN ENGINE_NUMBER LICENSE_PLATE MAC_ADDRESS OTHER }
enum DocumentType { COMPLAINT POLICE_REPORT INVOICE OBJECT_PHOTO PROOF_OF_PURCHASE RETURN_DOCUMENT OTHER }

model Role {
  id String @id @default(cuid())
  code String @unique
  name String
  users User[]
  permissions RolePermission[]
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  description String
  roles RolePermission[]
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Region {
  id String @id @default(cuid())
  name String @unique
  services Service[]
  reports TheftReport[]
}

model Service {
  id String @id @default(cuid())
  code String @unique
  name String
  type String
  parentId String?
  parent Service? @relation("ServiceHierarchy", fields: [parentId], references: [id])
  children Service[] @relation("ServiceHierarchy")
  regionId String?
  region Region? @relation(fields: [regionId], references: [id])
  users User[]
  reports TheftReport[]
  recoveries Recovery[]
}

model User {
  id String @id @default(cuid())
  matricule String @unique
  firstName String
  lastName String
  function String?
  passwordHash String
  status UserStatus @default(ACTIVE)
  roleId String
  role Role @relation(fields: [roleId], references: [id])
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reportsCreated TheftReport[] @relation("ReportCreator")
  recoveries Recovery[]
  returns Return[]
  searches SearchLog[]
  audits AuditLog[]
  sessions LoginSession[]
  notifications Notification[]
}

model Owner {
  id String @id @default(cuid())
  firstNameEncrypted String
  lastNameEncrypted String
  phoneEncrypted String
  secondPhoneEncrypted String?
  emailEncrypted String?
  identityType String?
  identityNumberEncrypted String?
  reports TheftReport[]
  createdAt DateTime @default(now())
}

model Category {
  id String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
  subcategories Subcategory[]
  objects ReportedObject[]
}

model Subcategory {
  id String @id @default(cuid())
  name String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  objects ReportedObject[]
  @@unique([categoryId, name])
}

model TheftReport {
  id String @id @default(cuid())
  reportNumber String @unique
  complaintNumber String?
  theftDate DateTime
  approximateTime String?
  location String
  commune String?
  district String?
  circumstances String?
  status ObjectStatus @default(STOLEN)
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id])
  regionId String
  region Region @relation(fields: [regionId], references: [id])
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  createdById String
  createdBy User @relation("ReportCreator", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  objects ReportedObject[]
  documents Document[]
  recoveries Recovery[]
  returns Return[]
  searches SearchLog[]
  auditLogs AuditLog[]
  notifications Notification[]
}

model ReportedObject {
  id String @id @default(cuid())
  reportId String
  report TheftReport @relation(fields: [reportId], references: [id])
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])
  brand String?
  model String?
  color String?
  year Int?
  description String?
  distinctiveMarks String?
  identifiers ObjectIdentifier[]
  photos ObjectPhoto[]
  createdAt DateTime @default(now())
}

model ObjectIdentifier {
  id String @id @default(cuid())
  objectId String
  object ReportedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  identifierType IdentifierType
  identifierValueEncrypted String
  normalizedValue String
  createdAt DateTime @default(now())
  @@unique([identifierType, normalizedValue])
  @@index([normalizedValue])
}

model ObjectPhoto {
  id String @id @default(cuid())
  objectId String
  object ReportedObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  storageKey String @unique
  mimeType String
  sizeBytes Int
  createdAt DateTime @default(now())
}

model Document {
  id String @id @default(cuid())
  reportId String
  report TheftReport @relation(fields: [reportId], references: [id])
  type DocumentType
  storageKey String @unique
  originalNameEncrypted String
  mimeType String
  sizeBytes Int
  checksum String
  scannedAt DateTime?
  createdAt DateTime @default(now())
}

model Recovery {
  id String @id @default(cuid())
  reportId String
  report TheftReport @relation(fields: [reportId], references: [id])
  recoveredAt DateTime
  location String
  circumstances String
  possessorEncrypted String?
  observations String?
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  officerId String
  officer User @relation(fields: [officerId], references: [id])
  createdAt DateTime @default(now())
}

model Return {
  id String @id @default(cuid())
  reportId String
  report TheftReport @relation(fields: [reportId], references: [id])
  returnedAt DateTime
  location String
  beneficiaryEncrypted String
  identityReferenceEncrypted String
  protocolReference String
  observations String?
  officerId String
  officer User @relation(fields: [officerId], references: [id])
  createdAt DateTime @default(now())
}

model SearchLog {
  id String @id @default(cuid())
  queryHash String
  queryType IdentifierType?
  reason String?
  matched Boolean
  reportId String?
  report TheftReport? @relation(fields: [reportId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  ipAddress String?
  sessionId String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  action String
  entityType String
  entityId String?
  reportId String?
  report TheftReport? @relation(fields: [reportId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  oldValue Json?
  newValue Json?
  reason String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id String @id @default(cuid())
  type String
  title String
  message String
  readAt DateTime?
  userId String
  user User @relation(fields: [userId], references: [id])
  reportId String?
  report TheftReport? @relation(fields: [reportId], references: [id])
  createdAt DateTime @default(now())
}

model LoginSession {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  lastActivityAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}
